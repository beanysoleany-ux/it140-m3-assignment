graph TD
    Start([Start]) --> Input[/Input: hours_worked/]
    Input --> Decision{Is hours_worked > 40?}
    
    Decision -- Yes --> CalcOT[overtime_hours = hours_worked - 40\ngross_pay = 40 * 20 + overtime_hours * 30]
    Decision -- No --> CalcReg[gross_pay = hours_worked * 20]
    
    CalcOT --> Output[/Output: gross_pay/]
    CalcReg --> Output
    Output --> End([End])
