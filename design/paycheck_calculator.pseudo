START
    // Declare variables
    DECLARE Real hoursWorked
    DECLARE Real regularPay
    DECLARE Real overtimePay
    DECLARE Real totalPay
    
    CONSTANT Real REGULAR_RATE = 20.00
    CONSTANT Real OVERTIME_RATE = 30.00
    CONSTANT Real MAX_REGULAR_HOURS = 40.00

    // Input
    DISPLAY "Enter the number of hours worked this week: "
    INPUT hoursWorked

    // Decision Branching & Processing
    IF hoursWorked <= MAX_REGULAR_HOURS THEN
        SET regularPay = hoursWorked * REGULAR_RATE
        SET overtimePay = 0.00
    ELSE
        SET regularPay = MAX_REGULAR_HOURS * REGULAR_RATE
        SET overtimePay = (hoursWorked - MAX_REGULAR_HOURS) * OVERTIME_RATE
    ENDIF

    SET totalPay = regularPay + overtimePay

    // Output
    DISPLAY "Weekly Paycheck Summary:"
    DISPLAY "Regular Pay: $" + regularPay
    DISPLAY "Overtime Pay: $" + overtimePay
    DISPLAY "Total Weekly Pay: $" + totalPay
END
